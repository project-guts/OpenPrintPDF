{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Print PDF",
  "version": "0.1.8",
  "identifier": "jp.openprintpdf.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Open Print PDF",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'; style-src 'self'; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "GutsProject",
    "shortDescription": "印刷用PDFの検査・アウトライン化・PDF/X-1a変換",
    "longDescription": "日本語フォントのアウトライン化、RGB画像のDeviceCMYK変換、PDF/X-1a変換を行うオープンソースの印刷用PDFツールです。",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "vendor/ghostscript/": "ghostscript/",
      "../../../LICENSE": "licenses/OpenPrintPDF-AGPL-3.0.txt",
      "../../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "allowDowngrades": false,
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "language": "ja-JP"
      },
      "nsis": {
        "template": "windows/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["Japanese", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    },
    "useLocalToolsDir": true
  }
}
